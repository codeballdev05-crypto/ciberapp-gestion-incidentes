# Copiar a .env y completar. NUNCA versionar .env (R-04).

# Conexión administrativa (migraciones y setup; rol con privilegios DDL)
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciberapp
DB_USER=postgres
DB_PASSWORD=

# Generadas automáticamente por `npm run setup` (proyecto/06_codigo/api) si faltan:
# rol de mínimo privilegio que usa la API en tiempo de ejecución
APP_DB_USER=app_incidentes
APP_DB_PASSWORD=
# secreto de firma de tokens de sesión
JWT_SECRET=
# contraseña compartida de los 4 usuarios demo (admin, gestor, analista, consultor)
DEMO_PASSWORD=
